---
import { siteConfig } from "../config/site";

interface Props {
  id: string;
}

const { id } = Astro.props;
const emailId = `${id}-email`;
---

<div class="newsletter-form-wrap">
  <form
    action={siteConfig.buttondownFormAction}
    method="post"
    class="embeddable-buttondown-form newsletter-form"
    aria-describedby={`${id}-consent ${id}-status`}
  >
    <div class="field email-field">
      <label class="visually-hidden" for={emailId}>Enter your email</label>
      <input
        type="email"
        name="email"
        id={emailId}
        autocomplete="email"
        inputmode="email"
        placeholder="Enter your email..."
        required
      />
    </div>

    <input
      class="button submit-button"
      type="submit"
      value="Subscribe me to the Letters"
    />
    <input
      type="hidden"
      name="tag"
      value="sub_tag_5ja83svvwp8s7brh1cm8ed8kwk"
    />
  </form>

  <p id={`${id}-consent`} class="consent">
    By subscribing, you agree to receive Letters from Cyrus two to three times
    each week. Unsubscribe at any time. <a href="/privacy"
      >Read the Privacy Policy.</a
    >
  </p>
  <p id={`${id}-status`} class="form-status">
    Your subscription is handled by Buttondown.
  </p>
</div>

<style>
  .newsletter-form-wrap {
    max-width: 46rem;
  }

  .newsletter-form,
  .field {
    display: grid;
  }

  .newsletter-form {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2);
  }

  .field {
    gap: var(--space-1);
    min-width: 0;
  }

  .field input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.72rem 0.85rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius);
    background: var(--color-paper);
  }

  .submit-button {
    cursor: pointer;
    white-space: nowrap;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .consent,
  .form-status {
    margin-block: var(--space-3) 0;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .form-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
